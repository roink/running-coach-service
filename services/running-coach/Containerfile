FROM docker.io/library/node:24-bookworm-slim AS codex
ARG CODEX_VERSION=0.166.0
RUN npm install --global @openai/codex@${CODEX_VERSION}

FROM docker.io/library/python:3.12-slim-bookworm
RUN apt-get update && apt-get install --yes --no-install-recommends \
    ca-certificates curl ripgrep git poppler-utils libstdc++6 bubblewrap \
    && apt-get clean
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /usr/local/lib/node_modules/@openai /usr/local/lib/node_modules/@openai
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /app/requirements.txt
COPY coach /usr/local/lib/python3.12/site-packages/coach
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/workspace/.cache/matplotlib CODEX_HOME=/codex HOME=/workspace
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["python", "-I", "-m"]
CMD ["coach.worker"]
